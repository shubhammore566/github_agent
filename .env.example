# Server-side GitHub OAuth App configuration.
# Users never see these values and never paste a GitHub PAT.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
PUBLIC_APP_URL=http://localhost:8501

# AI provider configuration
AI_PROVIDER=
AI_API_KEY=

# Optional app infrastructure secrets
DATABASE_URL=
SESSION_SECRET=
ENCRYPTION_KEY=

# AWS:
# Do NOT put user AWS access keys here.
# User AWS accounts are connected per-session through GitHub Actions OIDC.

# Optional, one-time, developer-only: host aws/github-agent-aws-oidc.yaml as a
# public-READ object in your own S3 bucket, then put its https URL here. This
# turns the sidebar's AWS "Connect" step into a single button that opens AWS,
# has the user sign in, and lands them straight on a pre-filled Create-stack
# page for their own account - no manual download/upload needed. The file
# itself is not sensitive (it only describes what to create; it grants
# nothing by existing), and AWS's quick-create links require an S3 URL
# specifically, so this step can't be skipped if you want the one-click flow.
# Leave blank to keep the existing "download the file, upload it yourself"
# fallback, which works with zero extra developer setup.
AWS_OIDC_TEMPLATE_URL=

# Optional, one-time, developer-only: callback service used to remove the
# Account ID / Role ARN copy-paste after CloudFormation completes.
# Deploy aws_setup_service/template.yaml once, then put its POST /callback URL here.
AWS_SETUP_CALLBACK_URL=
